# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
AGENTS.md
new-app-requirements.md
.aituber-live-settings.json
.aituber-live-chat-cache.json
.aituber-live-speech.json
.aituber-presentation-live.json
.aituber-presentation-playback.json

# local model artifacts
public/models/*
!public/models/.gitkeep
public/live-assets/*
!public/live-assets/.gitkeep
public/presentation-projects/*
!public/presentation-projects/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
